{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kedarnath30.github.io/product-event-pipeline/schemas/track/documents_uploaded.json",
  "title": "Documents Uploaded",
  "description": "User uploads underwriting documents.",
  "allOf": [
    {
      "$ref": "../common/envelope.json"
    }
  ],
  "type": "object",
  "required": [
    "event",
    "properties"
  ],
  "properties": {
    "type": {
      "const": "track"
    },
    "event": {
      "const": "Documents Uploaded"
    },
    "properties": {
      "type": "object",
      "required": [
        "application_id",
        "document_count",
        "document_types"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "pattern": "^app_[0-9a-z]{10}$"
        },
        "document_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "document_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "id",
              "mortgage_statement",
              "insurance",
              "tax_return",
              "pay_stub"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
